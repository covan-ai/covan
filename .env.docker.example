# Covan — Docker Compose environment.
#
#   cp .env.docker.example .env
#   # set OPENAI_API_KEY, then:
#   docker compose up --build
#
# Everything below already has a working local value except OPENAI_API_KEY.
# `.env` is gitignored — keep it that way.

# ---- The one thing you must supply -------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Optional: send completions somewhere other than OpenAI ------------
# Any OpenAI-compatible endpoint — Ollama, vLLM, LiteLLM, OpenRouter. Set both:
# the model list Covan ships is OpenAI's, so without OPENAI_MODEL every agent
# asks your endpoint for `gpt-4o`.
#
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   OPENAI_MODEL=llama3.3:70b
#
# OPENAI_API_KEY is still required — most local servers ignore it, so any
# non-empty string will do there.
#
# This moves conversations only. Documents are a separate setting below, and
# audio transcription is not movable at all — few compatible servers implement
# /audio/transcriptions. See docs/self-hosting.md.
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---- Optional: offer Anthropic's models too ----------------------------
# https://console.anthropic.com/settings/keys
#
# Covan needs exactly one provider to answer anything, and OPENAI_API_KEY above
# is it. Setting this adds three more to the model picker — claude-sonnet-4-6,
# claude-sonnet-4-5 and claude-haiku-4-5 — and is the *only* thing that makes
# them appear. Leave it empty and nothing this stack sends ever addresses
# Anthropic: the ids are not offered, not accepted, and not resolved.
#
# It does not replace OPENAI_API_KEY. Document embeddings and audio
# transcription have no Anthropic equivalent here and stay where they were.
#
# ANTHROPIC_BASE_URL is the Anthropic half of OPENAI_BASE_URL — a gateway or
# proxy in front of api.anthropic.com. Empty means Anthropic directly.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ---- Optional: send documents somewhere other than OpenAI --------------
# Embedding is where the whole text of every uploaded document is sent, so
# this is the setting that decides whether self-hosting keeps your files in.
# It does not follow OPENAI_BASE_URL above, so that moving your chat does not
# silently move your documents to an endpoint of a different width.
#
#   EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768
#
# EMBEDDING_DIMENSIONS must match both the model *and* the width the database
# column was declared with — 1536 out of the box. Changing it is a schema
# change plus a re-embed: supabase/optional/embedding_width.sql spells out the
# whole procedure, and the API refuses to start if the number is not a
# positive whole one.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# ---- Optional: retrieval's relevance floor -----------------------------
# Cosine similarity below which a retrieved chunk is dropped as irrelevant.
# Empty means 0.25, which was tuned against text-embedding-3-small. Another
# model's scores sit elsewhere: too high starves real matches, too low fills
# every prompt with noise, and neither is an error — the answers just get
# worse. Worth revisiting if you set EMBEDDING_MODEL. 0 disables the floor.
RAG_MIN_SIMILARITY=

# ---- Local Postgres ----------------------------------------------------
POSTGRES_PASSWORD=covan-local-dev-password
# Host port for psql / a GUI client. The database itself always listens on
# 5432 inside the compose network.
POSTGRES_PORT=54322

# ---- Supabase keys -----------------------------------------------------
# These are the standard self-host demo keys: JWTs signed with the JWT_SECRET
# below, published by Supabase for exactly this purpose. They are safe for a
# local stack and unsafe for anything reachable from the internet. Regenerate
# all three before exposing this to a network:
#   https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
JWT_EXPIRY=3600

# Realtime's Phoenix session/cookie signing base and its column encryption key.
# Local-only defaults; regenerate for anything networked:
#   openssl rand -base64 48
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
REALTIME_DB_ENC_KEY=supabaserealtime

# ---- Routine encryption ------------------------------------------------
# Encrypts stored delivery-channel credentials for agent routines with AES-GCM,
# so the key must decode to exactly 16, 24 or 32 bytes — anything else fails at
# the point a routine is saved, not at boot. The value below is 32 bytes of
# obviously-not-secret placeholder; replace it before anyone else can reach the
# stack. Generate with: openssl rand -base64 32
ROUTINE_SECRET_KEY=Y292YW4tbG9jYWwtZGV2LXJvdXRpbmUta2V5LTAwMDE=

# ---- URLs --------------------------------------------------------------
# Where a browser reaches the stack — the browser calls these itself, so they
# must never be compose service names. `http://kong:8000` here produces a
# frontend that cannot sign anyone in.
#
# Vite compiles VITE_* into the browser bundle, so these used to need a rebuild.
# The web image is now built against placeholders and fills them in at startup,
# so `docker compose up -d covan-web` is enough.
SUPABASE_PUBLIC_URL=http://localhost:8000
VITE_API_URL=http://localhost:8787
SITE_URL=http://localhost:3000
# Comma-separated exact origins the API accepts credentialed requests from.
ALLOWED_ORIGIN=http://localhost:3000

# ---- Network exposure --------------------------------------------------
# Which interface the published ports bind to. The default keeps the whole
# stack on loopback, because Docker publishes ports via nat/PREROUTING, which
# runs BEFORE your firewall's INPUT rules — `ufw default deny incoming` does
# not cover a published port, and the demo credentials above are in a public
# repository.
#
# Setting this to 0.0.0.0 puts Postgres and the Supabase gateway on the
# internet. Regenerate every secret in this file first. To serve real users,
# prefer putting a reverse proxy in front of ${COVAN_WEB_PORT} and leaving
# this alone.
BIND_ADDR=127.0.0.1

# Host ports. Change these if something else already owns them.
KONG_HTTP_PORT=8000
COVAN_API_PORT=8787
COVAN_WEB_PORT=3000

# How often the API looks for routines that are due, in milliseconds.
ROUTINE_TICK_MS=60000

# ---- Version -----------------------------------------------------------
# Which published image `docker compose pull` fetches. `latest` follows
# releases, `edge` follows main, and a semver like 0.1.0 pins one exactly (no
# leading `v` — the image tags are plain semver). Ignored when you build from
# source instead of pulling.
COVAN_VERSION=latest

# ---- Optional: how often one caller may ask -----------------------------
# Requests per minute. Unset takes the built-in defaults, so a stack nobody
# configured is still bounded — which is the point, since `POST /chat/stream`
# and friends spend money at OpenAI on every call.
#
# standard  in front of everything, keyed by the caller's address
# expensive in front of the six endpoints that buy a completion or a
#           transcription, keyed by the signed-in user
#
# Set either to 0 to turn that tier off, which is what you want if you already
# rate-limit in nginx, Caddy or Cloudflare in front of this — two limiters that
# disagree is worse than one. Counters live in the API process, so with more
# than one replica the effective limit is this times the number of replicas;
# limit at the proxy instead in that case. See docs/self-hosting.md.
RATE_LIMIT_STANDARD_PER_MINUTE=
RATE_LIMIT_EXPENSIVE_PER_MINUTE=

# ---- Optional: email delivery for routines -----------------------------
# Leave blank to disable email delivery. https://resend.com
RESEND_API_KEY=
RESEND_FROM=

# ---- Auth: confirm addresses before they're usable ---------------------
# "true" auto-confirms every signup, including invitations' accept_invitation,
# which now checks email_confirmed_at before letting an invite be consumed —
# so with autoconfirm on, that check never actually excludes anyone. Set this
# to "false" and configure GOTRUE_SMTP_* before the stack faces a network:
# otherwise any address can be registered and confirmed on sight.
MAILER_AUTOCONFIRM=true

# ---- Optional: connected sources ----------------------------------------
# OAuth client credentials for the sources a bundle can sync from. Leave any
# pair blank and that source is simply not offered — the Integrations page says
# which variables would turn it on rather than hiding the row.
#
# The redirect URI to register with both providers is your API's own:
#   http://localhost:8787/connections/callback   (or your API domain in prod)
#
# Notion: https://www.notion.so/my-integrations, "Public integration".
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
#
# Google: console.cloud.google.com, an OAuth client of type "Web application".
# Read docs/integrations.md before starting this one. Drive needs the
# `drive.readonly` scope, which Google classes as RESTRICTED: an unverified
# client works for up to 100 users behind an "unverified app" warning, and going
# past that needs Google's verification including a third-party security
# assessment. That is a cost with a lead time, not a checkbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: ask an agent from Slack ----------------------------------
# All three or none. A client pair without the signing secret installs fine and
# then rejects every event it is sent, which looks like a Slack outage.
#
# Create the app at api.slack.com/apps. It needs:
#   Redirect URL   <your API>/slack/callback
#   Event URL      <your API>/slack/events
#   Bot scopes     app_mentions:read, chat:write, im:history,
#                  users:read, users:read.email
#   Events         app_mention, message.im
#
# `users:read.email` is not optional: without it the app cannot tell who is
# asking, and Covan answers as nobody rather than as whoever installed it.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
