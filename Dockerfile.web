# syntax=docker/dockerfile:1
# check=skip=SecretsUsedInArgOrEnv
#
# The Covan frontend, built by Vite and served by the nitro node-server output.
#
# The check above is skipped because it fires on the name `VITE_SUPABASE_ANON_KEY`
# and is wrong twice over: the value in the ENV is a sentinel, not a key, and the
# anon key it stands in for is public by design — it is protected by row level
# security, not by being hidden, and it ships inside the browser bundle either
# way. A warning nobody can act on only teaches people to skip warnings.

FROM oven/bun:1.3.0-alpine AS build
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile
COPY . .

# NITRO_PRESET is a shell variable, never a .env value: nitro reads
# process.env.NITRO_PRESET before c12 loads dotenv, and skips .env entirely on a
# production build. vite.config.ts already defaults to node-server; stating it
# here means the image does not silently change target if that default moves.
ENV NITRO_PRESET=node-server

# Vite inlines VITE_* at build time, as literal strings in the JavaScript the
# browser downloads. Taken at face value that makes a publishable image
# impossible: whichever Supabase project built it would be baked into it.
#
# So the build gets sentinels, and scripts/web-runtime-config.mjs swaps them for
# the environment's real values when the container starts. The sentinel list is
# defined in that script and nowhere else — `--prepare` below reads it from
# there — so the two halves cannot drift apart.
#
# .invalid is reserved by RFC 2606 and can never resolve, so a bundle that
# somehow reaches a browser unsubstituted fails at the first request instead of
# reaching someone else's server.
ENV VITE_SUPABASE_URL=https://covan-sentinel-supabase-url.invalid
ENV VITE_SUPABASE_ANON_KEY=covan-sentinel-anon-key
ENV VITE_API_URL=https://covan-sentinel-api-url.invalid
ENV VITE_TERMS_URL=https://covan-sentinel-terms-url.invalid
ENV VITE_PRIVACY_URL=https://covan-sentinel-privacy-url.invalid
RUN bun run build

# Keep a pristine copy of every file that carries a sentinel. The container
# substitutes out of these rather than in place, so `docker restart` with a
# changed environment renders from the original bundle instead of trying to
# substitute into yesterday's substitution.
RUN bun scripts/web-runtime-config.mjs --prepare .output

# Node 22, not 20. @supabase/supabase-js constructs a RealtimeClient inside
# createClient(), and that constructor throws "Node.js detected but native
# WebSocket not found" on anything below Node 22 — global WebSocket only became
# available in Node 22. src/lib/supabase/client.ts is imported during SSR, so on
# Node 20 every single page renders the 500 error shell instead of the app. The
# build is perfectly green either way; the failure is entirely at runtime.
FROM node:22.23.2-alpine
WORKDIR /app
COPY --from=build --chown=node:node /app/.output ./.output
COPY --from=build --chown=node:node /app/scripts/web-runtime-config.mjs ./scripts/
USER node
ENV PORT=3000
ENV HOST=0.0.0.0
EXPOSE 3000

# Configure, then hand the process over. `exec` matters: without it node runs as
# a child of the shell, the shell is PID 1, and `docker stop` waits out its full
# timeout because a shell does not forward SIGTERM.
#
# `&&`, so a missing variable or a leftover sentinel stops the container here
# rather than starting a server that serves a frontend pointed at nothing.
CMD ["sh", "-c", "node scripts/web-runtime-config.mjs .output && exec node .output/server/index.mjs"]
