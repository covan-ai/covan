# Covan — Docker Compose environment.
#
#   cp .env.docker.example .env
#   # set OPENAI_API_KEY, then:
#   docker compose up --build
#
# Everything below already has a working local value except OPENAI_API_KEY.
# `.env` is gitignored — keep it that way.

# ---- The one thing you must supply -------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Local Postgres ----------------------------------------------------
POSTGRES_PASSWORD=covan-local-dev-password
# Host port for psql / a GUI client. The database itself always listens on
# 5432 inside the compose network.
POSTGRES_PORT=54322

# ---- Supabase keys -----------------------------------------------------
# These are the standard self-host demo keys: JWTs signed with the JWT_SECRET
# below, published by Supabase for exactly this purpose. They are safe for a
# local stack and unsafe for anything reachable from the internet. Regenerate
# all three before exposing this to a network:
#   https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
JWT_EXPIRY=3600

# Realtime's Phoenix session/cookie signing base and its column encryption key.
# Local-only defaults; regenerate for anything networked:
#   openssl rand -base64 48
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
REALTIME_DB_ENC_KEY=supabaserealtime

# ---- Routine encryption ------------------------------------------------
# Encrypts stored delivery-channel credentials for agent routines with AES-GCM,
# so the key must decode to exactly 16, 24 or 32 bytes — anything else fails at
# the point a routine is saved, not at boot. The value below is 32 bytes of
# obviously-not-secret placeholder; replace it before anyone else can reach the
# stack. Generate with: openssl rand -base64 32
ROUTINE_SECRET_KEY=Y292YW4tbG9jYWwtZGV2LXJvdXRpbmUta2V5LTAwMDE=

# ---- URLs --------------------------------------------------------------
# Where a browser reaches the stack. These are compiled into the frontend
# bundle at build time, so change them and rebuild (`docker compose build
# covan-web`) rather than expecting a restart to pick them up.
SUPABASE_PUBLIC_URL=http://localhost:8000
VITE_API_URL=http://localhost:8787
SITE_URL=http://localhost:3000
# Comma-separated exact origins the API accepts credentialed requests from.
ALLOWED_ORIGIN=http://localhost:3000

# Host ports. Change these if something else already owns them.
KONG_HTTP_PORT=8000
COVAN_API_PORT=8787
COVAN_WEB_PORT=3000

# How often the API looks for routines that are due, in milliseconds.
ROUTINE_TICK_MS=60000

# ---- Optional: email delivery for routines -----------------------------
# Leave blank to disable email delivery. https://resend.com
RESEND_API_KEY=
RESEND_FROM=
