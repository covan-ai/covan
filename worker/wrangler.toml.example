# Copy to wrangler.toml and fill in before deploying.

name = "covan-api"
main = "src/index.ts"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

# Pin the account this Worker deploys to. `wrangler login` decides which account
# you can reach, so without this a deploy while logged into a different account
# silently creates a second copy of the API there instead of failing.
# account_id = "your-cloudflare-account-id"

# -----------------------------------------------------------------------------
# Secrets — set with `wrangler secret put <NAME>` (never commit real values):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   OPENAI_API_KEY, ROUTINE_SECRET_KEY, RESEND_API_KEY, RESEND_FROM
#
# Optional, per integration. Leave a pair unset and that integration is simply
# not offered; the Integrations page names the variables rather than hiding the
# row. See docs/integrations.md for the redirect URLs and scopes to register.
#   NOTION_CLIENT_ID, NOTION_CLIENT_SECRET
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   SLACK_CLIENT_ID, SLACK_CLIENT_SECRET, SLACK_SIGNING_SECRET
# -----------------------------------------------------------------------------

[vars]
# Comma-separated allowlist of EXACT frontend origins. localhost is added in
# code for dev.
#
# Do not be tempted to pattern-match `*.vercel.app` here. Vercel serves
# project-name subdomains first-come on a shared apex, so a regex — even one
# anchored to your own project slug — can be satisfied by someone who names
# their project to embed that slug. Combined with `credentials: true` that is a
# real cross-origin read. List every preview host explicitly.
ALLOWED_ORIGIN = "https://your-app.example.com"

# Optional. Sends completions to an OpenAI-compatible endpoint instead of
# OpenAI. Not secrets, so they live here rather than in `wrangler secret put`.
# Set both — the shipped model list is OpenAI's, so on its own the base URL
# leaves every agent asking your endpoint for `gpt-4o`. Embeddings and
# transcription still go to OpenAI; docs/self-hosting.md explains why.
# OPENAI_BASE_URL = "https://openrouter.ai/api/v1"
# OPENAI_MODEL = "meta-llama/llama-3.3-70b-instruct"

# WORKER_HOST — this worker's own domain, for the routine engine's self-fetch
# guard. Leave unset on workers.dev (that whole domain class is already
# blocked); set it once a custom domain fronts this worker.

# Create the bucket before your first deploy: wrangler r2 bucket create covan-docs
# How often one caller may ask, backing `lib/ratelimit` on Cloudflare. Without
# these the Worker falls back to an in-process counter — correct under Docker,
# close to meaningless here, because isolates are many and short-lived. The
# fallback logs an error saying so rather than failing quietly, but the error is
# in a log nobody is reading at 3am. Declare both.
#
# `namespace_id` is any string unique within this Worker; it names the counter,
# not a resource you have to create. `period` accepts only 10 or 60, and
# lib/ratelimit fixes it at 60 so both runtimes agree what a limit means.
#
# standard: in front of everything including the token check, keyed by address.
# Generous, because a shared office is one address and this exists to bound how
# often the Supabase round trip in authMiddleware can be provoked.
[[ratelimits]]
name = "RATE_LIMIT_STANDARD"
namespace_id = "1001"
simple = { limit = 120, period = 60 }

# expensive: in front of the six endpoints that buy a completion or a
# transcription, keyed by the authenticated user. More than a person can type,
# far less than a loop can.
[[ratelimits]]
name = "RATE_LIMIT_EXPENSIVE"
namespace_id = "1002"
simple = { limit = 20, period = 60 }

[[r2_buckets]]
binding = "DOCS"
bucket_name = "covan-docs"

# No [triggers] here on purpose. The Workers Free plan caps an account at five
# cron triggers, and registering one past the cap fails the deploy at the
# schedules step — after the script has already uploaded, leaving a confusing
# half-succeeded deploy. Add a trigger back here on Workers Paid or when a slot
# frees up; `src/index.ts` still exports `scheduled`. Running it alongside a
# second cron Worker is safe: `claim_due_routines` uses
# `for update skip locked`, so two ticks can never claim the same routine.
#
# READ THIS BEFORE CONNECTING NOTION OR DRIVE. A connection sync writes
# documents, so it needs the R2 bucket bound above — and that bucket lives in
# THIS account. `wrangler.cron.toml` deploys the engine to a second account
# precisely because this one is out of trigger slots, and a Worker there cannot
# reach this bucket. It notices (`canSyncConnections` in src/types.ts) and skips
# with one line in `wrangler tail`, rather than failing every connection and
# pausing them.
#
# So on Cloudflare, connected sources sync only when THIS Worker has a cron
# trigger. Routines are unaffected either way. If you connect a source and it
# never syncs, this is why — free a slot or move to Workers Paid, then:
#
# [triggers]
# crons = ["*/5 * * * *"]
