{
  "name": "covan-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//engines": "Matches the frontend's floor so one `node` satisfies both halves of the repo, even though the API itself runs on Workers or Bun. See README.md.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:cron": "wrangler deploy -c wrangler.cron.toml",
    "dry:cron": "wrangler deploy -c wrangler.cron.toml --dry-run",
    "tail:cron": "wrangler tail -c wrangler.cron.toml",
    "typecheck": "tsc --noEmit",
    "dry": "wrangler deploy --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:node": "bun run src/node.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "cron-parser": "^4.9.0",
    "fast-xml-parser": "^5.11.0",
    "hono": "^4.13.3",
    "openai": "^4.104.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
