# Copy to wrangler.toml and fill in before deploying.

name = "covan-api"
main = "src/index.ts"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

# Pin the account this Worker deploys to. `wrangler login` decides which account
# you can reach, so without this a deploy while logged into a different account
# silently creates a second copy of the API there instead of failing.
# account_id = "your-cloudflare-account-id"

# -----------------------------------------------------------------------------
# Secrets — set with `wrangler secret put <NAME>` (never commit real values):
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   OPENAI_API_KEY, ROUTINE_SECRET_KEY, RESEND_API_KEY, RESEND_FROM
#
# Optional, per integration. Leave a pair unset and that integration is simply
# not offered; the Integrations page names the variables rather than hiding the
# row. See docs/integrations.md for the redirect URLs and scopes to register.
#   NOTION_CLIENT_ID, NOTION_CLIENT_SECRET
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   SLACK_CLIENT_ID, SLACK_CLIENT_SECRET, SLACK_SIGNING_SECRET
#   COMPOSIO_API_KEY — connected apps. Set it on the CRON WORKER TOO, or a
#     scheduled run and a chat turn disagree about what exists.
#   COMPOSIO_WEBHOOK_SECRET — routines that start on a connected app's event.
#     Made and printed by `bun run scripts/composio-webhook-subscribe.ts`. Set
#     it on the CRON WORKER TOO: that Worker makes the triggers this one
#     receives.
#   NOTION_WEBHOOK_VERIFICATION_TOKEN — routines that start on a Notion page
#     event. The token Notion sends to /notion/events when its webhook is made
#     (logged while this is unset). Set it on the CRON WORKER TOO.
#   RESEND_INBOUND_WEBHOOK_SECRET — inbound mail (replies to a report, a
#     routine's own address), with INBOUND_EMAIL_DOMAIN below. The signing
#     secret of the Resend webhook for `email.received`. Set both on the CRON
#     WORKER TOO: it sends most reports and keeps the subscriptions in step.
#   BROWSER_USE_API_KEY — the `browse` tool, which drives a real browser for
#     the pages http_request cannot reach, on browser-use's V4 API (the same
#     key as v2; a project with Zero Data Retention cannot use V4). SET IT ON
#     THE CRON WORKER TOO. The cron is a FALLBACK now: while the conversation
#     is open in a tab, the tab polls and settles the run itself, and the cron
#     Worker settles the runs whose tab was closed and stops a browser somebody
#     took over and walked away from. A key set only here starts tasks whose
#     answers never arrive once the tab is closed. Covan pays browser-use, not
#     the person asking, and a task is metered at 137,000 tokens against the
#     same allowance a chat turn spends. See docs/integrations.md.
#   BROWSER_USE_MODEL — optional; the model a browser run asks for. Unset means
#     gpt-5.6-luna (`DEFAULT_MODEL`, src/lib/browser/v4.ts). This Worker only:
#     the cron Worker never starts a run.
#   BROWSER_USE_REASONING — optional; how hard that model reasons: none, low,
#     medium, high, xhigh, max, or `provider` for browser-use's own default
#     (xhigh on gpt-5.6-luna). Unset means medium (`DEFAULT_REASONING`). This
#     Worker only, as above.
#   BROWSER_USE_V4_BASE_URL — optional; a proxy in front of
#     api.browser-use.com/api/v4 (runs, browsers, profiles). Unset means
#     browser-use. Set it on the cron Worker too, which polls those runs.
#   BROWSER_USE_BASE_URL — optional, and V2 ONLY: not consulted for any V4
#     request. It still carries v2 tasks created before the move to V4 (the
#     cron Worker drains them) and the account headroom check, which exists
#     only on v2.
# -----------------------------------------------------------------------------

[vars]
# Comma-separated allowlist of EXACT frontend origins. localhost is added in
# code for dev.
#
# Do not be tempted to pattern-match `*.vercel.app` here. Vercel serves
# project-name subdomains first-come on a shared apex, so a regex — even one
# anchored to your own project slug — can be satisfied by someone who names
# their project to embed that slug. Combined with `credentials: true` that is a
# real cross-origin read. List every preview host explicitly.
ALLOWED_ORIGIN = "https://your-app.example.com"

# Optional. Sends completions to an OpenAI-compatible endpoint instead of
# OpenAI. Not secrets, so they live here rather than in `wrangler secret put`.
# Set both — the shipped model list is OpenAI's, so on its own the base URL
# leaves every agent asking your endpoint for `gpt-4o`. Embeddings and
# transcription still go to OpenAI; docs/self-hosting.md explains why.
# OPENAI_BASE_URL = "https://openrouter.ai/api/v1"
# OPENAI_MODEL = "meta-llama/llama-3.3-70b-instruct"

# WORKER_HOST — this worker's own domain, for the routine engine's self-fetch
# guard. Leave unset on workers.dev (that whole domain class is already
# blocked); set it once a custom domain fronts this worker.

# INBOUND_EMAIL_DOMAIN — the domain Resend receives on for inbound mail, with
# RESEND_INBOUND_WEBHOOK_SECRET above. Keep in sync with wrangler.cron.toml.
# INBOUND_EMAIL_DOMAIN = "reply.example.com"

# Create the bucket before your first deploy: wrangler r2 bucket create covan-docs
# How often one caller may ask, backing `lib/ratelimit` on Cloudflare. Without
# these the Worker falls back to an in-process counter — correct under Docker,
# close to meaningless here, because isolates are many and short-lived. The
# fallback logs an error saying so rather than failing quietly, but the error is
# in a log nobody is reading at 3am. Declare both.
#
# `namespace_id` is any string unique within this Worker; it names the counter,
# not a resource you have to create. `period` accepts only 10 or 60, and
# lib/ratelimit fixes it at 60 so both runtimes agree what a limit means.
#
# standard: in front of everything including the token check, keyed by address.
# Generous, because a shared office is one address and this exists to bound how
# often the Supabase round trip in authMiddleware can be provoked.
[[ratelimits]]
name = "RATE_LIMIT_STANDARD"
namespace_id = "1001"
simple = { limit = 120, period = 60 }

# expensive: in front of the six endpoints that buy a completion or a
# transcription, keyed by the authenticated user. More than a person can type,
# far less than a loop can.
[[ratelimits]]
name = "RATE_LIMIT_EXPENSIVE"
namespace_id = "1002"
simple = { limit = 20, period = 60 }

# Where a chat turn runs, so it finishes after the tab that asked is closed —
# or after its person opens another conversation, which ends the request just
# the same. A Worker invocation ends with its connection; an alarm on a Durable
# Object is the one Cloudflare invocation nobody is connected to, and it may
# run for fifteen minutes. One object per conversation (`src/lib/turns`).
#
# Leave both blocks out and turns behave as they always did: they end with the
# request. SQLite-backed, so it works on Workers Free as well as Paid.
[[durable_objects.bindings]]
name = "TURN_ROOMS"
class_name = "TurnRoom"

[[migrations]]
tag = "v1-turn-rooms"
new_sqlite_classes = ["TurnRoom"]

# A turn's CPU is mostly waiting on the model, but a long one with many tool
# results parses a lot of JSON. Workers Paid allows up to five minutes; the
# default is thirty seconds, per invocation, and the alarm is one invocation.
# [limits]
# cpu_ms = 300000

[[r2_buckets]]
binding = "DOCS"
bucket_name = "covan-docs"

# The document engine's clock: one Durable Object per document being written,
# each section in its own alarm, so a long report keeps being written after its
# tab closes (`src/lib/docs/host.ts`). Optional — leave both blocks out and the
# open conversation moves a document along each time it checks, with the cron
# finishing anything nobody is watching. Needs Workers Paid.
#
# `[[migrations]]` is an append-only history keyed by `tag`, applied in order:
# this one comes after `TURN_ROOMS`' above, and both stay in the file for good.
[[durable_objects.bindings]]
name = "DOC_ROOMS"
class_name = "DocumentRoom"

[[migrations]]
tag = "v2-doc-rooms"
new_sqlite_classes = ["DocumentRoom"]

# Where a routine started by a webhook or an app event runs, one object per
# event (`src/lib/routines/poke-room.ts`). The sender is answered first and
# the routine runs afterwards; without this, "afterwards" is `waitUntil`, which
# Cloudflare ends thirty seconds after the response, and most runs take
# longer. Leave both blocks out and those runs still start, and are cut off
# when the thirty seconds are up. SQLite-backed, so it works on Workers Free.
[[durable_objects.bindings]]
name = "ROUTINE_ROOMS"
class_name = "RoutineRoom"

[[migrations]]
tag = "v3-routine-rooms"
new_sqlite_classes = ["RoutineRoom"]

# PDF export, printed by Cloudflare Browser Rendering (`src/lib/formats/pdf.ts`).
# Optional — without it the PDF button falls back to the browser's own print
# dialog. Billed by the browser-hour; one PDF is a few seconds of one.
[browser]
binding = "BROWSER"

# No [triggers] here on purpose. The Workers Free plan caps an account at five
# cron triggers, and registering one past the cap fails the deploy at the
# schedules step — after the script has already uploaded, leaving a confusing
# half-succeeded deploy. Add a trigger back here on Workers Paid or when a slot
# frees up; `src/index.ts` still exports `scheduled`. Running it alongside a
# second cron Worker is safe: `claim_due_routines` uses
# `for update skip locked`, so two ticks can never claim the same routine.
#
# READ THIS BEFORE CONNECTING NOTION OR DRIVE. A connection sync writes
# documents, so it needs the R2 bucket bound above — and that bucket lives in
# THIS account. `wrangler.cron.toml` deploys the engine to a second account
# precisely because this one is out of trigger slots, and a Worker there cannot
# reach this bucket. It notices (`canSyncConnections` in src/types.ts) and skips
# with one line in `wrangler tail`, rather than failing every connection and
# pausing them.
#
# So on Cloudflare, connected sources sync only when THIS Worker has a cron
# trigger. Routines are unaffected either way. If you connect a source and it
# never syncs, this is why — free a slot or move to Workers Paid, then:
#
# [triggers]
# crons = ["*/5 * * * *"]

# Whether this account is on Workers Paid, which decides how much one answer
# may spend.
#
# Unset means Free, and that is the safe default rather than a conservative
# one: every ceiling in this codebase was chosen against the **50 subrequests**
# a Free invocation gets, and a database read, a model call and a connected-app
# call are each one. Going over does not fail cleanly — past the cap every
# `fetch` stops working, and the OpenAI SDK calls that `Connection error.`, so
# the log says the network broke when what broke was the plan.
#
# Set it to "paid" only once the Cloudflare account actually is. What it buys is
# chat: 24 tool calls per answer instead of 8, and up to two further rounds when
# a turn is still working at the end of them. A scheduled run is unaffected — a
# tick runs a whole batch of them inside one invocation, which is a different
# sum, and docs/routines.md does it.
#
# WORKER_PLAN = "paid"

# Keep `console.error` bodies, not only the request line.
#
# A Worker with an HTTP surface looks observable without this — the dashboard
# shows every request, its status and its timings — and that is exactly what
# makes the gap easy to miss. What it does NOT show is anything the code
# logged, so a chat turn that fails sends the person a generic message, writes
# the real exception with `console.error`, and the real exception goes nowhere.
#
# The first production failure of a tool turn had to be caught by running
# `wrangler tail` and asking the person to trigger it a second time, which is
# not a debugging story anybody should repeat. Logs are sampled and retained
# for a few days, which is long enough to answer "what actually threw".
[observability]
enabled = true
