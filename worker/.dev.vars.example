# Copy this file to `.dev.vars` (gitignored) and fill in real values for local `wrangler dev`.
# Never commit `.dev.vars` or real secret values.
#
# In production these are set with `wrangler secret put <NAME>`, except
# ALLOWED_ORIGIN and WORKER_HOST, which are plain [vars] in wrangler.toml.
# See docs/self-hosting.md.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
OPENAI_API_KEY=replace-with-openai-api-key

# Optional. Sends completions to an OpenAI-compatible endpoint instead of
# OpenAI. Set OPENAI_MODEL alongside it — the shipped model list is OpenAI's,
# so on its own every agent would ask your endpoint for `gpt-4o`. Transcription
# still goes to OpenAI; docs/self-hosting.md says why.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.3:70b

# Optional, and separate from the two above on purpose: this is where the text
# of every uploaded document goes, which is a bigger decision than where the
# conversation goes, so it does not inherit from OPENAI_BASE_URL.
# EMBEDDING_DIMENSIONS must match both the model and the width
# document_chunks.embedding was declared with — 1536 unless you ran
# supabase/optional/embedding_width.sql, which is also where the procedure for
# changing it lives.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# Optional. Cosine-similarity floor for retrieval; unset means 0.25, which was
# tuned for text-embedding-3-small. Set your own if you change the embedding
# model — a wrong floor does not error, it just returns the wrong chunks.
# RAG_MIN_SIMILARITY=0.3

# Comma-separated EXACT frontend origins. Never a wildcard or a pattern —
# docs/self-hosting.md explains what that costs. localhost is allowed in code.
ALLOWED_ORIGIN=http://localhost:3000

# 32 random bytes, base64: `openssl rand -base64 32`
# Must decode to exactly 16, 24 or 32 bytes (AES-GCM), and must be byte-identical
# to the routine engine's copy — the API encrypts delivery secrets with it and
# the engine decrypts them.
ROUTINE_SECRET_KEY=

# Email delivery for routines. Leave blank to disable it.
RESEND_API_KEY=
RESEND_FROM=

# Optional. This Worker's own domain, for the routine engine's SSRF guard. Leave
# unset on workers.dev — that whole domain class is already blocked.
# WORKER_HOST=api.example.com

# Optional. Shared secret for POST /admin/backfill-embeddings, sent in the
# `x-admin-key` header. Unset, that endpoint fails closed.
# ADMIN_API_KEY=

# Not set here: DOCS_DIR. Document storage on Cloudflare is the DOCS R2 binding
# declared in wrangler.toml; DOCS_DIR is the Node/Docker filesystem fallback and
# is set by docker-compose.yml, not by this file.
