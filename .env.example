# Supabase project URL (public)
VITE_SUPABASE_URL=
# Supabase anon/public API key (safe for client-side use)
VITE_SUPABASE_ANON_KEY=
# Base URL of the Covan Worker API
VITE_API_URL=
# Where the "Terms" and "Privacy Policy" links on the sign-up form point.
# Leave both unset to use the built-in /terms and /privacy pages, which
# describe the licence and what the software sends where — accurate for anyone
# running Covan for their own team. Set them if you operate Covan as a service
# for other people: that needs an agreement this repository cannot write.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
# Nitro server build target, e.g. node-server (Docker / any plain Node host).
# Shell/CI variable only — nitro reads it from the environment before it loads
# this file, so setting it here has no effect. Pass it on the command line:
#   NITRO_PRESET=node-server bun run build
# Leave it unset when deploying to Vercel or Netlify; they are auto-detected.
# NITRO_PRESET=
