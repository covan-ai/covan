# Covan — Docker Compose environment.
#
#   cp .env.docker.example .env
#   # set OPENAI_API_KEY, then:
#   docker compose up --build
#
# Everything below already has a working local value except OPENAI_API_KEY.
# `.env` is gitignored — keep it that way.

# ---- The one thing you must supply -------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Optional: send completions somewhere other than OpenAI ------------
# Any OpenAI-compatible endpoint — Ollama, vLLM, LiteLLM, OpenRouter. Set both:
# the model list Covan ships is OpenAI's, so without OPENAI_MODEL every agent
# asks your endpoint for `gpt-4.1`.
#
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#   OPENAI_MODEL=llama3.3:70b
#
# OPENAI_API_KEY is still required — most local servers ignore it, so any
# non-empty string will do there.
#
# This moves conversations only. Documents are a separate setting below, and
# audio transcription is not movable at all — few compatible servers implement
# /audio/transcriptions. See docs/self-hosting.md.
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---- Optional: offer Anthropic's models too ----------------------------
# https://console.anthropic.com/settings/keys
#
# Covan needs exactly one provider to answer anything, and OPENAI_API_KEY above
# is it. Setting this adds six more to the model picker — claude-opus-5,
# claude-sonnet-5, claude-opus-4-8, claude-sonnet-4-6, claude-sonnet-4-5 and
# claude-haiku-4-5 — and is the *only* thing that makes them appear. Leave it empty and nothing this stack sends ever addresses
# Anthropic: the ids are not offered, not accepted, and not resolved.
#
# It does not replace OPENAI_API_KEY. Document embeddings and audio
# transcription have no Anthropic equivalent here and stay where they were.
#
# ANTHROPIC_BASE_URL is the Anthropic half of OPENAI_BASE_URL — a gateway or
# proxy in front of api.anthropic.com. Empty means Anthropic directly.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ---- Optional: send documents somewhere other than OpenAI --------------
# Embedding is where the whole text of every uploaded document is sent, so
# this is the setting that decides whether self-hosting keeps your files in.
# It does not follow OPENAI_BASE_URL above, so that moving your chat does not
# silently move your documents to an endpoint of a different width.
#
#   EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768
#
# EMBEDDING_DIMENSIONS must match both the model *and* the width the database
# column was declared with — 1536 out of the box. Changing it is a schema
# change plus a re-embed: supabase/optional/embedding_width.sql spells out the
# whole procedure, and the API refuses to start if the number is not a
# positive whole one.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# ---- Optional: retrieval's relevance floor -----------------------------
# Cosine similarity below which a retrieved chunk is dropped as irrelevant.
# Empty means 0.25, which was tuned against text-embedding-3-small. Another
# model's scores sit elsewhere: too high starves real matches, too low fills
# every prompt with noise, and neither is an error — the answers just get
# worse. Worth revisiting if you set EMBEDDING_MODEL. 0 disables the floor.
RAG_MIN_SIMILARITY=

# ---- Optional: how much knowledge one workspace may hold --------------
# A ceiling on passages per workspace: about 850 characters of text each, and
# about 7 KB of database with its embedding. Empty means no ceiling. A
# document that would take a workspace past it fails to index, saying so,
# before anything is embedded.
WORKSPACE_MAX_PASSAGES=

# ---- Optional: retrieval's lexical (keyword) arm -----------------------
# Turns the keyword-matching half of retrieval on or off. Alongside the usual
# vector search, retrieval also matches a question's significant words against
# the chunk text directly, so a code, a name or an acronym typed exactly as it
# appears in a document can be found even when it means little to the
# embedding model. Empty or "on" means enabled — that is the default. "off"
# disables it; any other value refuses to start.
# Worth turning off for a corpus that is neither Turkish nor English-with-
# common-terms: the matching has no language-specific dictionary behind it
# (deliberately — see 0049_the_words_as_well_as_the_meaning.sql), so on a
# corpus it was not tuned for it can add noisy matches without adding any
# real recall.
RAG_LEXICAL=

# ---- Local Postgres ----------------------------------------------------
POSTGRES_PASSWORD=covan-local-dev-password
# Host port for psql / a GUI client. The database itself always listens on
# 5432 inside the compose network.
POSTGRES_PORT=54322

# ---- Supabase keys -----------------------------------------------------
# These are the standard self-host demo keys: JWTs signed with the JWT_SECRET
# below, published by Supabase for exactly this purpose. They are safe for a
# local stack and unsafe for anything reachable from the internet. Regenerate
# all three before exposing this to a network:
#   https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
JWT_EXPIRY=3600

# Realtime's Phoenix session/cookie signing base and its column encryption key.
# Local-only defaults; regenerate for anything networked:
#   openssl rand -base64 48
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
REALTIME_DB_ENC_KEY=supabaserealtime

# ---- Routine encryption ------------------------------------------------
# Encrypts stored delivery-channel credentials for agent routines with AES-GCM,
# so the key must decode to exactly 16, 24 or 32 bytes — anything else fails at
# the point a routine is saved, not at boot. The value below is 32 bytes of
# obviously-not-secret placeholder; replace it before anyone else can reach the
# stack. Generate with: openssl rand -base64 32
ROUTINE_SECRET_KEY=Y292YW4tbG9jYWwtZGV2LXJvdXRpbmUta2V5LTAwMDE=

# ---- URLs --------------------------------------------------------------
# Where a browser reaches the stack — the browser calls these itself, so they
# must never be compose service names. `http://kong:8000` here produces a
# frontend that cannot sign anyone in.
#
# Vite compiles VITE_* into the browser bundle, so these used to need a rebuild.
# The web image is now built against placeholders and fills them in at startup,
# so `docker compose up -d covan-web` is enough.
SUPABASE_PUBLIC_URL=http://localhost:8000
VITE_API_URL=http://localhost:8787
SITE_URL=http://localhost:3000
# Comma-separated exact origins the API accepts credentialed requests from.
ALLOWED_ORIGIN=http://localhost:3000

# ---- Network exposure --------------------------------------------------
# Which interface the published ports bind to. The default keeps the whole
# stack on loopback, because Docker publishes ports via nat/PREROUTING, which
# runs BEFORE your firewall's INPUT rules — `ufw default deny incoming` does
# not cover a published port, and the demo credentials above are in a public
# repository.
#
# Setting this to 0.0.0.0 puts Postgres and the Supabase gateway on the
# internet. Regenerate every secret in this file first. To serve real users,
# prefer putting a reverse proxy in front of ${COVAN_WEB_PORT} and leaving
# this alone.
BIND_ADDR=127.0.0.1

# Host ports. Change these if something else already owns them.
KONG_HTTP_PORT=8000
COVAN_API_PORT=8787
COVAN_WEB_PORT=3000

# How often the API looks for routines that are due, in milliseconds.
ROUTINE_TICK_MS=60000

# ---- Version -----------------------------------------------------------
# By default `docker compose up` builds covan-api and covan-web from this
# checkout, so the app always matches the migrations `migrate` applies from it.
# Set COVAN_PULL=always to run the published images instead (`missing` pulls
# only when no image with that tag is present locally). A plain
# `docker compose pull` does nothing for these two while this is `build`.
COVAN_PULL=build

# Which published image tag COVAN_PULL fetches. `edge` follows main, which is
# what a clone is on; `latest` follows releases; a semver like 0.4.0 pins one
# exactly (no leading `v` — the image tags are plain semver). With
# COVAN_PULL=build it only names the image the build is tagged as. Pulling a
# release while running the migrations of a newer checkout puts a new schema
# under an old app: pin a release by checking out its tag as well.
COVAN_VERSION=edge

# ---- Optional: how often one caller may ask -----------------------------
# Requests per minute. Unset takes the built-in defaults, so a stack nobody
# configured is still bounded — which is the point, since `POST /chat/stream`
# and friends spend money at OpenAI on every call.
#
# standard  in front of everything, keyed by the caller's address
# expensive in front of the six endpoints that buy a completion or a
#           transcription, keyed by the signed-in user
#
# Set either to 0 to turn that tier off, which is what you want if you already
# rate-limit in nginx, Caddy or Cloudflare in front of this — two limiters that
# disagree is worse than one. Counters live in the API process, so with more
# than one replica the effective limit is this times the number of replicas;
# limit at the proxy instead in that case. See docs/self-hosting.md.
RATE_LIMIT_STANDARD_PER_MINUTE=
RATE_LIMIT_EXPENSIVE_PER_MINUTE=

# Who "the caller's address" is. Empty: the address the connection came from,
# with any X-Forwarded-For or CF-Connecting-IP ignored, because a client can
# send either. Behind a reverse proxy that address is the proxy's, so set this
# to the number of proxies in front of the API that append to X-Forwarded-For —
# 1 for a single nginx, Caddy or Traefik. Too high and a client can choose
# its own address again. See docs/self-hosting.md.
TRUST_PROXY=

# ---- Optional: email delivery for routines -----------------------------
# Leave blank to disable email delivery. https://resend.com
RESEND_API_KEY=
RESEND_FROM=

# ---- Optional: where a request for more credits goes --------------------
# Inert on an ordinary self-hosted stack, because this repository ships only
# unlimitedEntitlements: nobody here ever runs out of credits. It is here for
# the one self-hoster who has registered a metered entitlements implementation
# of their own — and because a variable that cannot be set is a variable an
# operator cannot turn off either.
#
# SUPPORT_EMAIL is where the "ask for more credits" form delivers. Blank means
# efe@covan.app — the address already public in this repository — which is
# almost certainly not what you want on your own install: POST /support/quota
# is mounted on every deployment, so leaving this blank lets your users mail
# Covan's own inbox through your Resend account.
SUPPORT_EMAIL=

# ---- Auth: confirm addresses before they're usable ---------------------
# "true" auto-confirms every signup, so any address can be registered and
# confirmed on sight. Fine on a laptop. docker/check-secrets.sh refuses to
# start a stack that faces a network (a non-localhost ALLOWED_ORIGIN, or a
# BIND_ADDR other than loopback) with it on: set this to "false" and configure
# GOTRUE_SMTP_* first.
MAILER_AUTOCONFIRM=true

# ---- Optional: connected sources ----------------------------------------
# OAuth client credentials for the sources a bundle can sync from. Leave any
# pair blank and that source is simply not offered — the Integrations page says
# which variables would turn it on rather than hiding the row.
#
# The redirect URI to register with both providers is your API's own:
#   http://localhost:8787/connections/callback   (or your API domain in prod)
#
# WORKER_HOST is that API's host, without the scheme, and is required as soon
# as any client ID below is set: the redirect URIs are built from it rather
# than from whatever Host header a request arrives with.
WORKER_HOST=
#
# Notion: https://www.notion.so/my-integrations, "Public integration".
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
#
# Google: console.cloud.google.com, an OAuth client of type "Web application".
# Read docs/integrations.md before starting this one. Drive needs the
# `drive.readonly` scope, which Google classes as RESTRICTED: an unverified
# client works for up to 100 users behind an "unverified app" warning, and going
# past that needs Google's verification including a third-party security
# assessment. That is a cost with a lead time, not a checkbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: sign in with Google or GitHub ---------------------------
# Adds "Continue with Google" / "Continue with GitHub" to the sign-in and
# sign-up cards. Each provider is off until its _ENABLED is true; the buttons
# appear by themselves once it is. Both providers ask for the same callback,
# which is GoTrue's, not the app's:
#
#   ${SUPABASE_PUBLIC_URL}/auth/v1/callback
#
# Google: console.cloud.google.com, a separate OAuth client of type "Web
# application" — not the Drive client above, whose restricted scope would put
# every sign-in behind Google's verification. Sign-in only asks for the
# address and the name, which needs no review.
# GitHub: github.com/settings/developers → New OAuth App.
SIGN_IN_GOOGLE_ENABLED=false
SIGN_IN_GOOGLE_CLIENT_ID=
SIGN_IN_GOOGLE_SECRET=
SIGN_IN_GITHUB_ENABLED=false
SIGN_IN_GITHUB_CLIENT_ID=
SIGN_IN_GITHUB_SECRET=

# ---- Optional: ask an agent from Slack ----------------------------------
# All three or none. A client pair without the signing secret installs fine and
# then rejects every event it is sent, which looks like a Slack outage.
#
# Create the app at api.slack.com/apps. It needs:
#   Redirect URL   <your API>/slack/callback
#   Event URL      <your API>/slack/events
#   Bot scopes     app_mentions:read, chat:write, im:history,
#                  users:read, users:read.email
#   Events         app_mention, message.im
#
# `users:read.email` is not optional: without it the app cannot tell who is
# asking, and Covan answers as nobody rather than as whoever installed it.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---- Optional: connected apps -------------------------------------------
# One key, and agents can search about 1500 applications and call the ones
# somebody has connected — Gmail, HubSpot, Linear, Slack — without pasting a
# token into Covan. Blank means the feature is not offered and the Integrations
# page names this variable rather than hiding the card.
#
# Counted against the live API on 2026-10-05: 1437 of 1596 can be connected
# from the Integrations page. 123 need a sign-in alone (every common one does);
# 1280 need a key the person connecting gets from the application itself, typed
# on a page Composio hosts; 34 need nothing at all and connect without leaving
# the page; the remaining 159 need a client registered in Composio's dashboard
# first, and say so in the catalogue rather than failing at the consent screen.
#
# Get one at app.composio.dev. Read docs/integrations.md before turning this on
# — four things are worth knowing in advance:
#
#   1. It adds a SUBPROCESSOR. The credentials live at Composio, and data
#      passing through an operation passes through them. Covan stores an opaque
#      reference and no third-party token or key.
#   2. The page that collects a sign-in or a key carries COMPOSIO'S BRAND until
#      you set your own in Composio's project settings — Project Settings →
#      White Labeling. Do that before pointing anybody at it: it is your users
#      typing a secret on a page that does not say your name.
#   3. Calls COST MONEY. Composio bills per tool call. A self-hosted install
#      charges nobody credits, as for everything else, which means unbounded:
#      watch Composio's bill.
COMPOSIO_API_KEY=
# Optional. A proxy or a self-hosted Composio in front of backend.composio.dev.
COMPOSIO_BASE_URL=
# Optional, with the key above: routines that start on an event in a connected
# app (a new Gmail or Outlook mail, a calendar event about to start). The
# signing secret of the project's webhook subscription, which
# `bun run scripts/composio-webhook-subscribe.ts https://<api host>` (in
# worker/) makes and prints. Composio must be able to reach this API over
# https. Empty means routines cannot start on app events. See
# docs/integrations.md.
COMPOSIO_WEBHOOK_SECRET=

# Optional, with NOTION_CLIENT_ID/SECRET: routines that start when a Notion page
# is created, edited or commented on. Point the Notion integration's webhook at
# https://<api host>/notion/events; the API logs the one-time
# verification_token Notion sends while this is empty. Paste that token into
# Notion's Verify form, then set it here. See docs/integrations.md.
NOTION_WEBHOOK_VERIFICATION_TOKEN=
# Optional, with RESEND_API_KEY: inbound mail. Replying to a routine's emailed
# report starts the routine again with the reply, and a routine can be given an
# address of its own to be mailed at. INBOUND_EMAIL_DOMAIN is the domain Resend
# receives on (its MX record points at Resend); the secret is the signing
# secret of the Resend webhook that sends `email.received` to
# https://<api host>/email/inbound. Both empty means no inbound mail. See
# docs/integrations.md.
INBOUND_EMAIL_DOMAIN=
RESEND_INBOUND_WEBHOOK_SECRET=

# Optional. The `browse` tool: one plain-language instruction, carried out by a
# real browser at browser-use, for the pages http_request cannot reach — HTML
# behind JavaScript, a supplier portal with no API. Unset, the tool is not
# offered and the Integrations page names this variable.
#
# Four things to know first:
#   1. It adds a SUBPROCESSOR. The task sentence, and whatever the browser
#      reads, go to browser-use. See docs/security.md.
#   2. YOU pay, not the person asking. One deployment key, billed to you.
#      A self-hosted install charges nobody credits, which here means
#      unbounded: watch the provider's bill. Each run is capped by maxCostUsd.
#   3. NO PASSWORD IS EVER HANDED TO AN AGENT, and that is enforced rather
#      than documented — the provider's `secrets` field is never populated.
#      A task that stops at a login wall instead offers the person the
#      browser, in a panel beside the conversation, where they sign in
#      themselves; the cookies live in a per-person profile at the provider
#      and go when that account does.
#   4. THE KEY MUST BE FROM A PROJECT WITHOUT ZERO DATA RETENTION. The browser
#      runs on browser-use's V4 API (the same key as v2), and the provider
#      answers 403 "Zero Data Retention is enabled on the project (V4
#      unsupported)" to a project that has it on.
BROWSER_USE_API_KEY=
# Optional. The model a browser run asks for. Blank means gpt-5.6-luna, the
# default in worker/src/lib/browser/v4.ts.
BROWSER_USE_MODEL=
# Optional. How hard that model reasons: none, low, medium, high, xhigh, max,
# or `provider` for browser-use's own default (xhigh on gpt-5.6-luna). Blank
# means medium, DEFAULT_REASONING in worker/src/lib/browser/v4.ts.
BROWSER_USE_REASONING=
# Optional. A proxy in front of api.browser-use.com/api/v4, where runs, browsers
# and profiles go. Blank means browser-use.
BROWSER_USE_V4_BASE_URL=
# Optional, and V2 ONLY: not consulted for any V4 request. It still carries the
# v2 tasks created before the move to V4 (drained until none are left) and the
# account headroom check, because /billing/account exists only on v2.
BROWSER_USE_BASE_URL=
