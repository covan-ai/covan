# Copy to wrangler.cron.toml and fill in before deploying.
#
# The routine engine, deployed on its own.
#
# Same codebase as the API Worker, different entry point (src/cron.ts).
# Cloudflare's Free plan caps an account at five cron triggers. If your
# account has a free slot, you can deploy this alongside the API Worker on the
# same account; if it doesn't, pin a second account's id below and deploy the
# engine there instead.
#
#   deploy:  bun run deploy:cron    (from worker/)
#   logs:    bun run tail:cron
#
# Secrets to set before the first deploy — `wrangler secret
# put <NAME> -c wrangler.cron.toml` for each:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   OPENAI_API_KEY
#   ROUTINE_SECRET_KEY   <- MUST be byte-identical to the API Worker's. The API
#                           encrypts delivery_channels.secret_ciphertext with it
#                           and this Worker decrypts. A different key here makes
#                           every Slack webhook and email address undecryptable.
#   RESEND_API_KEY
#   RESEND_FROM
#   COMPOSIO_API_KEY     <- only if the API Worker has it. A scheduled routine
#                           can call a connected application exactly as a chat
#                           turn can, and `lib/harness/available.ts` decides
#                           which tools exist by asking the environment — so a
#                           key here and not there, or there and not here, is an
#                           agent that works when you ask it and not overnight.
#                           That is the one difference nobody can debug, and it
#                           is why the two lists have to match.
#   COMPOSIO_WEBHOOK_SECRET <- REQUIRED here if the API Worker has it. This
#                           Worker makes and renews the trigger instances the
#                           API Worker receives, and offers the events only
#                           when both the key and this secret are set.
#   NOTION_WEBHOOK_VERIFICATION_TOKEN <- REQUIRED here if the API Worker has
#                           it, for the same reason: this Worker keeps the
#                           Notion subscriptions, and both must agree they exist.
#   RESEND_INBOUND_WEBHOOK_SECRET <- REQUIRED here if the API Worker has it,
#                           with INBOUND_EMAIL_DOMAIN in [vars]: this Worker
#                           puts the Reply-To on the reports it sends.
#   BROWSER_USE_API_KEY  <- REQUIRED here if the API Worker has it. This Worker
#                           is the FALLBACK now, not the only clock: while a
#                           conversation is open in a tab, the tab polls its
#                           own run every three seconds and settles it, so the
#                           answer lands inline. What this Worker's tick does
#                           is settle the runs whose tab was closed (and the v2
#                           tasks from before the move to V4, which only this
#                           poll drains), and stop a browser somebody took over
#                           and walked away from, so the sign-in they just
#                           performed is saved. Set there and not here and a
#                           task whose tab was closed starts, charges somebody's
#                           allowance, and is never heard from again — the only
#                           sign is one warning line per idle tick in
#                           `wrangler tail`, which is deliberately there because
#                           nothing in the database would explain it.
#   BROWSER_USE_V4_BASE_URL <- the same rule, if you set one: this Worker polls
#                           V4 runs and stops V4 browsers, so a proxy that the
#                           API Worker has and this one lacks sends them to
#                           browser-use directly.
#   BROWSER_USE_BASE_URL <- V2 only, the same rule if you set one: this Worker
#                           drains v2 tasks through it.
#   (BROWSER_USE_MODEL is the API Worker's alone: this Worker starts no run.)
#
# Not set here, deliberately: SUPABASE_ANON_KEY. This Worker only ever uses the
# service role, so a user-scoped key would be a credential with no caller.
#
# ---- Syncing connected sources from this Worker ----------------------------
#
# Off by default, and turning it on is two things that must happen in this
# order. Doing the second without the first is worse than leaving it off.
#
# 1. The four OAuth client secrets, the same way as the ones above:
#      NOTION_CLIENT_ID / NOTION_CLIENT_SECRET
#      GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#    Only the pairs you actually offer. A sync re-reads the source with the
#    person's stored token, and Google's access tokens last an hour — refreshing
#    one needs the client secret, so a Worker without it cannot sync Drive even
#    though the connection is perfectly good.
#
# 2. The DOCS binding below, uncommented. A sync writes documents, and this is
#    where they go. It only works if this Worker is on the same account as the
#    bucket — an R2 binding cannot cross accounts — so an engine you moved to a
#    second account to escape the five-cron cap cannot have it at all. In that
#    case leave both off and put the cron trigger on the API Worker instead;
#    wrangler.toml.example says so where the trigger would go.
#
# The order matters because of what the two halves do when they are missing.
# `lib/background` checks for both before it claims anything, and skips with one
# log line if either is absent — so all-off and half-off are both safe. What it
# is protecting against is further down: `lib/connections/sync` treats a
# provider without credentials as a provider the deployment has *removed*, and
# pauses the connection with a message telling the person to go and ask an
# operator. A Worker given storage but not secrets would reach that path for
# every connection in every workspace. The guard means it no longer can, and
# the ordering above means you never find out whether the guard works.

name = "covan-routines"
main = "src/cron.ts"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

# No public URL. This Worker exports no `fetch` handler, and its only entry
# point is the cron trigger below — putting it on the internet would add attack
# surface for a Worker nothing is meant to call.
workers_dev = false

# Pin the account this Worker deploys to. `wrangler login` decides which
# account you can reach, so without this a deploy while logged into the wrong
# account silently creates a second copy of the engine there instead of
# failing. If you're deploying to a second account (see the header above),
# pin that account's id here — leave it unset if you're deploying alongside
# the API Worker on the same account.
# account_id = "your-cloudflare-account-id"

[vars]
# Not about CORS here — this Worker serves no HTTP. The SSRF guard reads it so a
# routine cannot be pointed back at your own frontend. Keep in sync with
# wrangler.toml.
ALLOWED_ORIGIN = "https://your-app.example.com"

# Optional, and only if the API Worker sets them too — otherwise scheduled work
# keeps calling OpenAI while chat has moved on. Both must match wrangler.toml.
# OPENAI_BASE_URL = "https://openrouter.ai/api/v1"
# OPENAI_MODEL = "meta-llama/llama-3.3-70b-instruct"

# Inbound mail: the same domain as wrangler.toml, so the reports this Worker
# sends carry a Reply-To the API Worker can receive.
# INBOUND_EMAIL_DOMAIN = "reply.example.com"

# Where a sync puts the documents it reads. Step 2 of the header's two, and the
# one to uncomment second — the same bucket name as wrangler.toml, since both
# Workers must read and write the same documents. Leave commented to keep this
# Worker on routines only.
# [[r2_buckets]]
# binding = "DOCS"
# bucket_name = "covan-docs"

# Passage embeddings beside the database (migration 0116, src/lib/passages.ts).
# Optional — leave it out and `document_chunks.embedding` is the index, as on
# Node. Bound, new passages keep their vectors here instead, and the background
# tick moves the ones already in the column across a page at a time; a free
# Supabase database is mostly vectors otherwise. Create the index and its
# bundle filter BEFORE binding it, and bind it on both Workers:
#
#   wrangler vectorize create covan-passages --dimensions=1536 --metric=cosine
#   wrangler vectorize create-metadata-index covan-passages --property-name=bundle_id --type=string
#
# --dimensions must match EMBEDDING_DIMENSIONS (unset is 1536).
# [[vectorize]]
# binding = "PASSAGES"
# index_name = "covan-passages"

# The engine's heartbeat. It only asks "is anything due?" — each routine's own
# frequency lives in routines.next_run_at, so "every 15 minutes" and "Mondays at
# 09:00" both run off this one trigger.
#
# It is also what makes syncing from here worth setting up. A connection claimed
# on this trigger is re-read within minutes; the alternative in the header — a
# cron on the API Worker — shares that Worker's schedule, which exists for the
# nightly purge and so refreshes a source about once a day.
[triggers]
crons = ["*/5 * * * *"]

# Whether this account is on Workers Paid, which decides how much one answer
# may spend.
#
# Unset means Free, and that is the safe default rather than a conservative
# one: every ceiling in this codebase was chosen against the **50 subrequests**
# a Free invocation gets, and a database read, a model call and a connected-app
# call are each one. Going over does not fail cleanly — past the cap every
# `fetch` stops working, and the OpenAI SDK calls that `Connection error.`, so
# the log says the network broke when what broke was the plan.
#
# What it buys here is 24 tool calls per routine run instead of 8, with the
# token ceiling a chat turn has (chat itself gets the same 24 plus two further
# rounds, on the API Worker). Set it on both Workers or neither: a routine run
# started by an event runs on the API Worker, one started by the clock runs
# here, and the two would otherwise get different budgets. A tick runs a whole
# batch of routines inside one invocation, and docs/routines.md does that sum.
#
# WORKER_PLAN = "paid"

# A Worker with no HTTP surface is invisible without this: it puts each tick's
# console output in the dashboard's Workers Logs.
[observability]
enabled = true
